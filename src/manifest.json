{
    "manifest_version": 3,
    "name": "Gmail PDF Archiver",
    "description": "Seamlessly download and archive your Gmail conversations as high-quality PDFs with all attachments included.",
    "version": "1.0",
    "permissions": [
        "downloads",
        "tabs",
        "debugger"
    ],
    "host_permissions": [
        "https://mail.google.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ]
        }
    ],
    "icons": {
        "16": "assets/icon.webp",
        "48": "assets/icon.webp",
        "128": "assets/icon.webp"
    },
    "action": {
        "default_icon": {
            "16": "assets/icon.webp",
            "48": "assets/icon.webp",
            "128": "assets/icon.webp"
        }
    }
}